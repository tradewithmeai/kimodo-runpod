# Paths to the existing motion model (reused, not duplicated)
MDM_REPO=D:\Documents\11Projects\Kimodo\local\motion-diffusion-model
LINEL_MOTION_APP_DIR=D:\Documents\11Projects\Kimodo\local\app
LINEL_CHECKPOINT=

# Runtime
LINEL_DEVICE=cpu
LINEL_TORCH_THREADS=2
LINEL_HOST=127.0.0.1
LINEL_PORT=8000

# Credits
LINEL_SIGNUP_CREDITS=20
LINEL_CREDITS_PER_GENERATION=1

# Auth — leave GOOGLE_CLIENT_ID empty to use the dev login locally.
# Setting it automatically disables the dev login.
GOOGLE_CLIENT_ID=
LINEL_SECRET_KEY=
LINEL_COOKIE_SECURE=false
